<%- include('partials/header') %>
<div class="page-title"><div><span class="eyebrow">FLEXIBLE FITNESS OPTIONS</span><h1>Membership Plans</h1><p>Create plans that fit every fitness journey.</p></div></div>
<section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">CREATE A PLAN</span><h3>Add membership plan</h3></div></div>
<form action="/plans/add" method="POST" class="form-grid"><input name="plan_name" placeholder="Plan name" required><input name="duration_months" type="number" min="1" placeholder="Duration (months)" required><input name="fee" type="number" min="0" step="0.01" placeholder="Fee (₹)" required><input name="description" placeholder="Description"><button class="btn">＋ Create plan</button></form></section>
<div class="plan-grid"><% plans.forEach((p,i)=>{ %><article class="plan-card <%= i===1?'featured':'' %>"><span class="plan-number">PLAN 0<%= i+1 %></span><h2><%= p.plan_name %></h2><p><%= p.description || 'A fitness plan designed for your goals.' %></p><div class="plan-price">₹<%= Number(p.fee).toLocaleString('en-IN') %><small> / plan</small></div><div class="plan-duration">◷ <%= p.duration_months %> month<%= p.duration_months>1?'s':'' %></div><form action="/plans/<%= p.plan_id %>/delete" method="POST" onsubmit="return confirm('Delete this plan?')"><button class="btn-outline">Remove plan</button></form></article><% }) %></div>
<%- include('partials/footer') %>