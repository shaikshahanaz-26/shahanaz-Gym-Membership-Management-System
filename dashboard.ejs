<%- include('partials/header') %>
<section class="welcome"><div><span class="eyebrow light">YOUR FITNESS CLUB AT A GLANCE</span><h1>Welcome back,<br><em>Shahanaz.</em></h1><p>Manage members, memberships and trainers — all in one elegant workspace.</p><a class="btn btn-light" href="/members">＋ Add a member</a></div><div class="welcome-art"><div class="sun"></div><div class="art-text">STRONGER<br><span>EVERY DAY</span></div><div class="art-line"></div></div></section>
<div class="section-heading"><div><span class="eyebrow">OVERVIEW</span><h2>Dashboard insights</h2></div><span class="date-chip">✦ Membership overview</span></div>
<div class="stats-grid">
<div class="stat-card"><div class="stat-icon">♙</div><span>Total Members</span><strong><%= stats.total_members %></strong><small>Registered members</small></div>
<div class="stat-card"><div class="stat-icon">▣</div><span>Active Memberships</span><strong><%= stats.active_memberships %></strong><small>Currently enrolled</small></div>
<div class="stat-card"><div class="stat-icon">⌛</div><span>Expired Memberships</span><strong><%= stats.expired_memberships %></strong><small>Need renewal</small></div>
<div class="stat-card"><div class="stat-icon">₹</div><span>Paid Revenue</span><strong>₹<%= Number(stats.revenue).toLocaleString('en-IN') %></strong><small>Recorded paid plans</small></div>
</div>
<div class="two-col">
<section class="panel"><div class="panel-head"><div><span class="eyebrow">RECENT ACTIVITY</span><h3>Latest subscriptions</h3></div><a class="text-link" href="/subscriptions">View all ↗</a></div>
<% if(latest.length){ %><div class="table-wrap"><table><thead><tr><th>Member</th><th>Plan</th><th>Expiry</th><th>Payment</th></tr></thead><tbody>
<% latest.forEach(s=>{ %><tr><td><b><%= s.member_name %></b></td><td><%= s.plan_name %></td><td><%= s.end_date %></td><td><span class="status <%= s.payment_status.toLowerCase() %>"><%= s.payment_status %></span></td></tr><% }) %>
</tbody></table></div><% } else { %><div class="empty">No subscriptions yet. Create your first subscription to see it here.</div><% } %></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">COMING UP</span><h3>Memberships expiring soon</h3></div><span class="mini-badge"><%= expiring.length %> in 7 days</span></div>
<% if(expiring.length){ expiring.forEach(e=>{ %><div class="expiry-item"><div class="expiry-icon">⌛</div><div><b><%= e.member_name %></b><small><%= e.plan_name %></small></div><span><%= e.end_date %></span></div><% }) %><% } else { %><div class="empty">You're all caught up. No memberships expire in the next 7 days.</div><% } %></section>
</div>
<div class="creator-banner"><div class="creator-logo">S</div><div><span class="eyebrow">CRAFTED BY</span><h3>Shaik Shehanaz</h3><p>Gym Membership Management System · B.Tech Computer Science</p></div><span class="creator-note">CREATED WITH PASSION ✦</span></div>
<%- include('partials/footer') %>