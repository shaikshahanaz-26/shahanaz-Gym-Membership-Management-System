<%- include('partials/header') %>
<div class="page-title"><div><span class="eyebrow">COACHING TEAM</span><h1>Trainers</h1><p>Meet your trainers and connect them with members.</p></div></div>
<div class="two-col trainer-cols"><section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">ADD TO YOUR TEAM</span><h3>New trainer</h3></div></div><form action="/trainers/add" method="POST" class="stack-form"><input name="trainer_name" placeholder="Trainer name" required><input name="specialization" placeholder="Specialization (e.g. Yoga)"><input name="phone" placeholder="Phone number"><button class="btn">＋ Add trainer</button></form></section>
<section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">PERSONAL COACHING</span><h3>Assign trainer</h3></div></div><% if(members.length && trainers.length){ %><form action="/trainers/assign" method="POST" class="stack-form"><select name="member_id" required><option value="">Select member</option><% members.forEach(m=>{ %><option value="<%= m.member_id %>"><%= m.name %></option><% }) %></select><select name="trainer_id" required><option value="">Select trainer</option><% trainers.forEach(t=>{ %><option value="<%= t.trainer_id %>"><%= t.trainer_name %></option><% }) %></select><button class="btn">Assign trainer</button></form><% } else { %><p class="muted">Add a member and trainer first.</p><% } %></section></div>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">YOUR EXPERTS</span><h3>Trainer directory</h3></div></div><div class="trainer-grid"><% trainers.forEach(t=>{ %><article class="trainer-card"><div class="trainer-avatar"><%= t.trainer_name.charAt(0).toUpperCase() %></div><h3><%= t.trainer_name %></h3><p><%= t.specialization || 'Fitness trainer' %></p><small><%= t.phone || 'Phone not provided' %></small><div class="trainer-assigned"><b><%= t.assigned_count %></b> assigned member(s)</div><form action="/trainers/<%= t.trainer_id %>/delete" method="POST" onsubmit="return confirm('Remove this trainer?')"><button class="btn-outline">Remove trainer</button></form></article><% }) %></div><% if(!trainers.length){ %><div class="empty">No trainers added yet.</div><% } %></section>
<%- include('partials/footer') %>