<%- include('partials/header') %>
<div class="page-title"><div><span class="eyebrow">MEMBERSHIP ENROLLMENT</span><h1>Subscriptions</h1><p>Enroll members, track renewals and payment status.</p></div></div>
<section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">NEW ENROLLMENT</span><h3>Create subscription</h3></div></div>
<% if(members.length && plans.length){ %><form action="/subscriptions/add" method="POST" class="form-grid"><select name="member_id" required><option value="">Choose member</option><% members.forEach(m=>{ %><option value="<%= m.member_id %>"><%= m.name %></option><% }) %></select><select name="plan_id" required><option value="">Choose plan</option><% plans.forEach(p=>{ %><option value="<%= p.plan_id %>"><%= p.plan_name %> · <%= p.duration_months %> month(s)</option><% }) %></select><label>Start date<input type="date" name="start_date" required value="<%= new Date().toISOString().slice(0,10) %>"></label><select name="payment_status"><option>Pending</option><option>Paid</option><option>Failed</option></select><button class="btn">＋ Enroll member</button></form><% } else { %><div class="empty">Please add at least one member and one plan before creating a subscription.</div><% } %></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">ALL ENROLLMENTS</span><h3>Subscription records <span class="count"><%= subscriptions.length %></span></h3></div></div>
<div class="table-wrap"><table><thead><tr><th>Member</th><th>Plan</th><th>Start date</th><th>Expiry date</th><th>Membership</th><th>Payment</th><th>Actions</th></tr></thead><tbody>
<% subscriptions.forEach(s=>{ %><tr><td><b><%= s.member_name %></b><small class="subline">#<%= s.subscription_id %></small></td><td><%= s.plan_name %><small class="subline">₹<%= Number(s.fee).toLocaleString('en-IN') %></small></td><td><%= s.start_date %></td><td><%= s.end_date %></td><td><span class="status <%= s.membership_status.toLowerCase() %>"><%= s.membership_status %></span></td><td><form action="/subscriptions/<%= s.subscription_id %>/payment" method="POST" class="inline-form"><select name="payment_status"><% ['Pending','Paid','Failed'].forEach(v=>{ %><option <%= s.payment_status===v?'selected':'' %>><%= v %></option><% }) %></select><button class="btn btn-small">Update</button></form></td><td><form action="/subscriptions/<%= s.subscription_id %>/delete" method="POST" onsubmit="return confirm('Delete subscription?')"><button class="btn-danger">Delete</button></form></td></tr><% }) %>
</tbody></table></div><% if(!subscriptions.length){ %><div class="empty">No subscriptions yet.</div><% } %></section>
<%- include('partials/footer') %>